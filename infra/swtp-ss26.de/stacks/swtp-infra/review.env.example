# === Database ===
SPRING_PROFILES_ACTIVE=mysql
SPRING_DATASOURCE_USERNAME=swtp
SPRING_DATASOURCE_PASSWORD=change-me-swtp

# === Mail ===
SPRING_MAIL_HOST=maildev
SPRING_MAIL_PORT=1025

# === Uploads ===
APP_UPLOADS_DIR=/app/uploads

# === Logging ===
BE_LOG_LEVEL=DEBUG

# === External services ===
OPENAI_API_KEY=sk-proj-...
SPRING_DATA_REDIS_HOST=redis.ser.mlanima.org

# === Discord ===
DISCORD_BOT_BASEURL=http://discord.ser.mlanima.org:3001
DISCORD_BOT_API_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# === GitHub integration ===
# Review apps have dynamic, per-PR hostnames, so there's no single callback URL to
# register a GitHub OAuth App against. Leave these unset — the integration
# self-disables (connect/link endpoints return 503) but everything else still works.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
